---
import { getCollection } from "astro:content";
import NoteList from "../../components/NoteList.astro";
import TopicChips from "../../components/TopicChips.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	collectTags,
	formatTag,
	prepareNotes,
	type Note,
} from "../../lib/notes";

export async function getStaticPaths() {
	const entries = await getCollection("catatan");
	const notes = prepareNotes(entries, {
		includeDrafts: import.meta.env.DEV,
		strict: import.meta.env.PROD,
	});
	const topics = collectTags(notes);

	return topics.map(({ tag }) => ({
		params: { tag },
		props: {
			tag,
			notes: notes.filter((note) => note.tags.includes(tag)),
			topics,
		},
	}));
}

interface Props {
	tag: string;
	notes: Note[];
	topics: { tag: string; count: number }[];
}

const { tag, notes, topics } = Astro.props;
const name = formatTag(tag);
const otherTopics = topics.filter((topic) => topic.tag !== tag);
---

<BaseLayout
	title={name}
	description={`Catatan dengan topik ${name} di Bad Broke.`}>
	<div class="mx-auto w-full max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
		<header class="max-w-2xl">
			<a
				href="/topik/"
				class="text-sm text-muted underline underline-offset-4 hover:text-accent">
				Semua topik
			</a>
			<h1 class="mt-3 font-serif text-4xl leading-tight">{name}</h1>
			<p class="mt-3 text-muted">{notes.length} catatan</p>
		</header>

		<div class="mt-8">
			<NoteList
				notes={notes}
				headingLevel={2}
			/>
		</div>

		{
			otherTopics.length > 0 && (
				<section class="mt-12 border-t border-line/70 pt-8">
					<h2 class="font-serif text-2xl">Topik lain</h2>
					<div class="mt-4">
						<TopicChips
							topics={otherTopics}
							label="Topik lain"
						/>
					</div>
				</section>
			)
		}
	</div>
</BaseLayout>
