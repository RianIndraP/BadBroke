---
import {
	formatShortDate,
	formatTag,
	type Note,
} from "../lib/notes";

interface Props {
	notes: Note[];
	variant?: "default" | "compact";
	headingLevel?: 2 | 3;
	emptyMessage?: string;
	emptyHref?: string;
	emptyLabel?: string;
}

const {
	notes,
	variant = "default",
	headingLevel = 3,
	emptyMessage = "Belum ada catatan.",
	emptyHref,
	emptyLabel,
} = Astro.props;

const Heading = `h${headingLevel}` as "h2" | "h3";
const dateAttribute = (date: Date) => date.toISOString().slice(0, 10);
---

{
	notes.length === 0 ? (
		<div class="py-4 text-muted">
			<p>{emptyMessage}</p>
			{emptyHref && emptyLabel && (
				<a
					href={emptyHref}
					class="mt-2 inline-block underline underline-offset-4 hover:text-accent">
					{emptyLabel}
				</a>
			)}
		</div>
	) : variant === "compact" ? (
		<ul class="divide-y divide-line/70">
			{notes.map((note) => (
				<li class="py-3">
					<a
						href={`/catatan/${note.id}/`}
						class="group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
						<span class="font-serif text-lg leading-snug transition-colors group-hover:text-accent">
							{note.title}
						</span>
						<time
							datetime={dateAttribute(note.date)}
							class="shrink-0 text-sm text-muted">
							{formatShortDate(note.date)}
						</time>
					</a>
				</li>
			))}
		</ul>
	) : (
		<ul class="divide-y divide-line/70">
			{notes.map((note) => (
				<li class="py-6 first:pt-0 last:pb-0">
					<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
						<time datetime={dateAttribute(note.date)}>
							{formatShortDate(note.date)}
						</time>
						{note.draft && (
							<span class="rounded-full border border-line px-2 py-0.5 text-xs tracking-wide uppercase">
								Draft
							</span>
						)}
					</div>
					<Heading class="mt-1 font-serif text-xl leading-snug">
						<a
							href={`/catatan/${note.id}/`}
							class="transition-colors hover:text-accent">
							{note.title}
						</a>
					</Heading>					<p class="mt-1 max-w-2xl text-pretty leading-relaxed text-muted">
						{note.summary}
					</p>
					{note.tags.length > 0 && (
						<ul
							class="mt-3 flex flex-wrap gap-2"
							aria-label="Topik catatan">
							{note.tags.map((tag) => (
								<li>
									<a
										href={`/topik/${tag}/`}
										class="chip">
										{formatTag(tag)}
									</a>
								</li>
							))}
						</ul>
					)}
				</li>
			))}
		</ul>
	)
}
