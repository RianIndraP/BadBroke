---
import { siteConfig } from "../config";
---

<footer class="border-t border-line/70" data-pagefind-ignore>
	<div class="mx-auto flex w-full max-w-5xl flex-col gap-3 px-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
		<p>
			&copy; {siteConfig.year}&nbsp;&nbsp; {siteConfig.author}
			<span aria-hidden="true">&nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;</span>
			{siteConfig.tagline}
		</p>
		<nav
			aria-label="Navigasi footer"
			class="flex flex-wrap gap-x-4 gap-y-1">
			<a
				href="/catatan/"
				class="transition-colors hover:text-accent">
				Semua catatan
			</a>
			<a
				href="/tentang/"
				class="transition-colors hover:text-accent">
				Tentang
			</a>
			<a
				href="/rss.xml"
				class="transition-colors hover:text-accent">
				RSS
			</a>
		</nav>
	</div>
</footer>
