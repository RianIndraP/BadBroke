---
import { siteConfig } from "../config";

const year = new Date().getFullYear();
---

<footer class="border-t border-line/70">
	<div class="mx-auto flex w-full max-w-5xl flex-col gap-1 px-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
		<p>
			&copy; {year} {siteConfig.author}
		</p>
		<p>{siteConfig.tagline}</p>
	</div>
</footer>
