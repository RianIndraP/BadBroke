---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
	{ href: "/catatan/", label: "Catatan" },
	{ href: "/topik/", label: "Topik" },
	{ href: "/tentang/", label: "Tentang" },
];

const isActive = (href: string) => {
	const base = href.replace(/\/+$/, "");
	return path === base || path.startsWith(`${base}/`);
};
---

<header
	class="sticky top-0 z-40 border-b border-line/70 bg-paper/90 backdrop-blur-sm"
	data-pagefind-ignore>
	<div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between gap-2 px-5 sm:px-8">
		<a
			href="/"
			aria-label={`${siteConfig.title}, kembali ke beranda`}
			class="font-serif text-xl font-semibold tracking-tight text-ink transition-colors hover:text-accent">
			{siteConfig.title}<span class="wordmark-dot text-accent">.</span>
		</a>

		<div class="flex items-center gap-1 sm:gap-2">
			<button
				type="button"
				data-search-open
				hidden
				aria-label="Cari catatan"
				aria-keyshortcuts="Control+K"
				title="Cari catatan (Ctrl+K)"
				class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent sm:size-9">
				<Icon
					name="ph:magnifying-glass"
					class="size-4"
					aria-hidden="true"
				/>
			</button>

			<nav
				aria-label="Navigasi utama"
				class="hidden items-center gap-0.5 sm:flex sm:gap-1">
				{links.map((link) => (
					<a
						href={link.href}
						aria-current={isActive(link.href) ? "page" : undefined}
						class:list={[
							"whitespace-nowrap rounded-full px-3 py-2 text-sm transition-colors",
							isActive(link.href)
								? "text-accent"
								: "text-muted hover:text-ink",
						]}>
						{link.label}
					</a>
				))}
			</nav>

			<ThemeToggle />

			<details class="relative sm:hidden">
				<summary
					class="menu-summary inline-flex size-11 list-none items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent"
					aria-label="Menu navigasi">
					<Icon
						name="ph:list"
						class="size-4"
						aria-hidden="true"
					/>
				</summary>
				<nav
					aria-label="Navigasi seluler"
					class="absolute top-full right-0 z-50 mt-2 w-48 rounded-[14px] border border-line bg-surface p-2 shadow-lg">
					<ul class="flex flex-col">
						{links.map((link) => (
							<li>
								<a
									href={link.href}
									aria-current={isActive(link.href) ? "page" : undefined}
									class:list={[
										"flex min-h-11 items-center rounded-lg px-3 text-sm transition-colors",
										isActive(link.href)
											? "bg-accent-soft text-accent"
											: "text-muted hover:bg-accent-soft hover:text-accent",
									]}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
			</details>
		</div>
	</div>
</header>
