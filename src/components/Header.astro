---
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
	{ href: "/catatan/", label: "Catatan" },
	{ href: "/topik/", label: "Topik" },
	{ href: "/tentang/", label: "Tentang" },
];

const isActive = (href: string) => {
	const base = href.replace(/\/+$/, "");
	return path === base || path.startsWith(`${base}/`);
};
---

<header class="border-b border-line/70">
	<div class="mx-auto flex h-16 w-full max-w-5xl items-center justify-between gap-2 px-5 sm:px-8">
		<a
			href="/"
			aria-label="Arsip, kembali ke beranda"
			class="font-serif text-xl font-semibold tracking-tight text-ink transition-colors hover:text-accent">
			arsip<span class="wordmark-dot text-accent">.</span>
		</a>

		<nav
			aria-label="Navigasi utama"
			class="flex items-center gap-0.5 sm:gap-1">
			{links.map((link) => (
				<a
					href={link.href}
					aria-current={isActive(link.href) ? "page" : undefined}
					class:list={[
						"whitespace-nowrap rounded-full px-2 py-2 text-[13px] transition-colors sm:px-3 sm:text-sm",
						isActive(link.href)
							? "text-accent"
							: "text-muted hover:text-ink",
					]}>
					{link.label}
				</a>
			))}
			<ThemeToggle />
		</nav>
	</div>
</header>
